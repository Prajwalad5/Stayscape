generator client {
  provider = "prisma-client-js"
  output   = "./generated/sqlite"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  device       String?
  ipAddress    String?
  userAgent    String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                      String                    @id @default(cuid())
  name                    String?
  email                   String                    @unique
  emailVerified           DateTime?
  emailSearchHash         String?                   @unique
  encryptedEmail          String?
  encryptedBio            String?
  image                   String?
  passwordHash            String?
  role                    String                    @default("USER")
  isHost                  Boolean                   @default(false)
  bio                     String?
  phone                   String?                   @unique
  phoneVerified           Boolean                   @default(false)
  status                  String                    @default("ACTIVE")
  stripeCustomerId        String?                   @unique
  stripeAccountId         String?                   @unique
  stripeOnboardingDone    Boolean                   @default(false)
  loginAttempts           Int                       @default(0)
  lockedUntil             DateTime?
  deletedAt               DateTime?
  lastLoginAt             DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  adminRole               String?
  permissions             String?
  suspendedAt             DateTime?
  suspensionReason        String?
  department              String?
  loginId                 String?                   @unique
  managementId            String?                   @unique
  accounts                Account[]
  adminActions            AdminAction[]
  adminUser               AdminUser?
  analyticsEvents         AnalyticsEvent[]
  auditLogs               AuditLog[]                @relation("AuditUser")
  bookings                Booking[]                 @relation("GuestBookings")
  conversations           ConversationParticipant[]
  devices                 Device[]
  disputes                Dispute[]                 @relation("DisputeFiler")
  favorites               Favorite[]
  fraudEvents             FraudEvent[]
  hostEarnings            HostEarning[]
  sentMessages            Message[]                 @relation("MessageSender")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  passwordResets          PasswordReset[]
  payouts                 Payout[]
  payoutAccounts          PayoutAccount[]
  properties              Property[]
  reviewsReceived         Review[]                  @relation("ReviewTarget")
  reviewsGiven            Review[]                  @relation("ReviewAuthor")
  sessions                Session[]
  supportTickets          SupportTicket[]
  profile                 UserProfile?
  userRoles               UserRole[]
  verifications           UserVerification[]
  wallet                  Wallet?
  wishlists               Wishlist[]

  @@index([email])
  @@index([role])
  @@index([adminRole])
  @@index([status])
}

model UserProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  firstName    String?
  lastName     String?
  dateOfBirth  DateTime?
  gender       String?
  bio          String?
  profilePhoto String?
  country      String?
  language     String?   @default("en")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  userRoles   UserRole[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Device {
  id         String   @id @default(cuid())
  userId     String
  deviceType String?
  os         String?
  browser    String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserVerification {
  id          String    @id @default(cuid())
  userId      String
  type        String
  status      String    @default("PENDING")
  documentUrl String?
  token       String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type, status])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Property {
  id                     String                   @id @default(cuid())
  hostId                 String
  title                  String
  description            String
  propertyType           String
  roomType               String                   @default("ENTIRE_PLACE")
  status                 String                   @default("DRAFT")
  address                String
  city                   String
  state                  String?
  country                String
  countryCode            String?
  postalCode             String?
  latitude               Float
  longitude              Float
  googlePlaceId          String?
  formattedAddress       String?
  maxGuests              Int                      @default(1)
  bedrooms               Int                      @default(1)
  beds                   Int                      @default(1)
  bathrooms              Float                    @default(1)
  kitchens               Int                      @default(0)
  livingRooms            Int                      @default(0)
  totalRooms             Int?
  pricePerNight          Int
  cleaningFee            Int                      @default(0)
  currency               String                   @default("usd")
  serviceFeePercent      Float                    @default(0.12)
  minNights              Int                      @default(1)
  maxNights              Int                      @default(365)
  cancellationPolicy     String                   @default("FLEXIBLE")
  isInstantBook          Boolean                  @default(true)
  houseRules             String?
  checkInTime            String?                  @default("15:00")
  checkOutTime           String?                  @default("11:00")
  checkInInstructions    String?
  averageRating          Float?                   @default(0)
  reviewCount            Int                      @default(0)
  viewCount              Int                      @default(0)
  rentalType             String?                  @default("SHORT_TERM")
  pricePerWeek           Int?
  pricePerMonth          Int?
  securityDeposit        Int                      @default(0)
  advanceRequired        Boolean                  @default(false)
  advanceType            String?
  advanceAmount          Int?
  fixedTerm              Boolean                  @default(false)
  electricityBillingType String?
  electricityCharge      Int?
  waterBillingType       String?
  waterCharge            Int?
  internetBillingType    String?
  internetCharge         Int?
  maintenanceCharge      Int?
  parkingCharge          Int?
  otherCharges           Json?
  availableFrom          DateTime?
  requiresStartDate      Boolean                  @default(false)
  requiresEndDate        Boolean                  @default(false)
  requiresCheckIn        Boolean                  @default(true)
  requiresCheckOut       Boolean                  @default(true)
  availabilityMode       String                   @default("STRICT")
  deletedAt              DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  publishedAt            DateTime?
  availability           Availability[]
  bookings               Booking[]
  cancellationPolicies   CancellationPolicyRule[]
  conversations          Conversation[]
  favorites              Favorite[]
  location               ListingLocation?
  priceRules             PriceRule[]
  host                   User                     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  amenities              PropertyAmenity[]
  images                 PropertyImage[]
  reviews                Review[]
  wishlistItems          WishlistItem[]

  @@index([hostId])
  @@index([city, country])
  @@index([latitude, longitude])
  @@index([pricePerNight])
  @@index([status])
  @@index([propertyType])
  @@index([roomType])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  key        String?
  caption    String?
  sortOrder  Int      @default(0)
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
}

model Amenity {
  id         String            @id @default(cuid())
  name       String            @unique
  icon       String?
  category   String?
  properties PropertyAmenity[]
}

model PropertyAmenity {
  id         String   @id @default(cuid())
  propertyId String
  amenityId  String
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, amenityId])
}

model ListingLocation {
  id         String   @id @default(cuid())
  listingId  String   @unique
  country    String?
  state      String?
  city       String?
  district   String?
  address    String?
  postalCode String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())
  listing    Property @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([city])
  @@index([country])
}

model PriceRule {
  id        String    @id @default(cuid())
  listingId String
  priceType String
  startDate DateTime?
  endDate   DateTime?
  price     Int
  createdAt DateTime  @default(now())
  listing   Property  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([startDate, endDate])
}

model CancellationPolicyRule {
  id            String   @id @default(cuid())
  listingId     String
  policyType    String
  refundPercent Int
  daysBefore    Int
  createdAt     DateTime @default(now())
  listing       Property @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model Availability {
  id          String   @id @default(cuid())
  propertyId  String
  date        DateTime
  isAvailable Boolean  @default(true)
  customPrice Int?
  minNights   Int?
  maxNights   Int?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, date])
  @@index([propertyId, date])
}

model Booking {
  id                     String                 @id @default(cuid())
  bookingNumber          String?                @unique
  propertyId             String
  guestId                String
  checkIn                DateTime?
  checkOut               DateTime?
  startDate              DateTime?
  endDate                DateTime?
  totalNights            Int
  guestCount             Int                    @default(1)
  adults                 Int                    @default(1)
  children               Int                    @default(0)
  infants                Int                    @default(0)
  pets                   Int                    @default(0)
  nightlyRate            Int
  subtotal               Int
  cleaningFee            Int
  serviceFee             Int
  taxAmount              Int                    @default(0)
  discount               Int                    @default(0)
  totalPrice             Int
  hostPayoutAmount       Int
  currency               String                 @default("usd")
  rentalType             String?
  securityDepositAmount  Int                    @default(0)
  securityDepositStatus  String?
  advanceAmount          Int                    @default(0)
  electricityBillingType String?
  electricityCharge      Int?
  waterBillingType       String?
  waterCharge            Int?
  internetBillingType    String?
  internetCharge         Int?
  maintenanceCharge      Int?
  parkingCharge          Int?
  otherCharges           Json?
  durationMonths         Int?
  bookingStatus          String                 @default("REQUESTED")
  paymentStatus          String                 @default("CREATED")
  paymentProvider        String?
  paymentMethod          String?
  providerPaymentId      String?                @unique
  receiptNumber          String?                @unique
  depositAmount          Int                    @default(0)
  paidAt                 DateTime?
  expiresAt              DateTime?
  stripePaymentIntentId  String?                @unique
  cancelledAt            DateTime?
  cancellationReason     String?
  refundAmount           Int?
  specialRequests        String?
  confirmedAt            DateTime?
  completedAt            DateTime?
  isDemo                 Boolean                @default(false)
  deletedAt              DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  guest                  User                   @relation("GuestBookings", fields: [guestId], references: [id])
  property               Property               @relation(fields: [propertyId], references: [id])
  bookingGuests          BookingGuest[]
  statusHistory          BookingStatusHistory[]
  conversation           Conversation?
  dispute                Dispute?
  hostEarning            HostEarning?
  payment                Payment?
  refunds                Refund[]
  review                 Review?
  transactions           Transaction[]

  @@index([propertyId, checkIn, checkOut])
  @@index([guestId])
  @@index([bookingStatus])
  @@index([paymentStatus])
  @@index([providerPaymentId])
  @@index([stripePaymentIntentId])
  @@index([bookingNumber])
}

model BookingGuest {
  id        String  @id @default(cuid())
  bookingId String
  guestType String
  count     Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model BookingStatusHistory {
  id        String   @id @default(cuid())
  bookingId String
  status    String
  changedBy String?
  note      String?
  changedAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([changedAt])
}

model Payment {
  id                    String         @id @default(cuid())
  bookingId             String         @unique
  provider              String         @default("demo")
  providerPaymentId     String?        @unique
  receiptNumber         String?        @unique
  depositAmount         Int            @default(0)
  paymentMethod         String?
  idempotencyKey        String?        @unique
  amount                Int
  currency              String         @default("usd")
  status                String         @default("CREATED")
  platformFeeAmount     Int
  hostPayoutAmount      Int
  processingFee         Int            @default(0)
  refundedAmount        Int            @default(0)
  isDemo                Boolean        @default(false)
  verifiedAt            DateTime?
  metadata              Json?
  stripePaymentIntentId String?        @unique
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  authorizedAt          DateTime?
  capturedAt            DateTime?
  failedAt              DateTime?
  paidAt                DateTime?
  userId                String?
  booking               Booking        @relation(fields: [bookingId], references: [id])
  events                PaymentEvent[]
  refunds               Refund[]
  transactions          Transaction[]

  @@index([provider])
  @@index([status])
  @@index([stripePaymentIntentId])
  @@index([userId])
}

model PaymentEvent {
  id              String   @id @default(cuid())
  paymentId       String
  provider        String
  eventType       String
  providerEventId String?
  payload         Json?
  processed       Boolean  @default(false)
  createdAt       DateTime @default(now())
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([paymentId])
}

model Refund {
  id               String    @id @default(cuid())
  paymentId        String
  bookingId        String
  amount           Int
  currency         String    @default("usd")
  reason           String?
  status           String    @default("PENDING")
  provider         String    @default("demo")
  providerRefundId String?   @unique
  isWalletCredit   Boolean   @default(false)
  processedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  booking          Booking   @relation(fields: [bookingId], references: [id])
  payment          Payment   @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([bookingId])
  @@index([status])
}

model Transaction {
  id          String   @id @default(cuid())
  paymentId   String?
  bookingId   String?
  type        String
  amount      Int
  currency    String   @default("usd")
  status      String   @default("PENDING")
  description String?
  createdAt   DateTime @default(now())
  booking     Booking? @relation(fields: [bookingId], references: [id])
  payment     Payment? @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([bookingId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model HostEarning {
  id                 String    @id @default(cuid())
  hostId             String
  bookingId          String    @unique
  paymentId          String?
  grossAmount        Int
  platformCommission Int
  processingFee      Int       @default(0)
  refundDeduction    Int       @default(0)
  netEarnings        Int
  currency           String    @default("usd")
  status             String    @default("PENDING")
  availableDate      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  payoutId           String?
  payout             Payout?   @relation(fields: [payoutId], references: [id])
  booking            Booking   @relation(fields: [bookingId], references: [id])
  host               User      @relation(fields: [hostId], references: [id])

  @@index([hostId])
  @@index([status])
  @@index([bookingId])
}

model PayoutAccount {
  id               String   @id @default(cuid())
  userId           String
  type             String
  provider         String
  accountName      String
  accountNumber    String?
  maskedIdentifier String
  bankName         String?
  branchName       String?
  metadata         Json?
  isVerified       Boolean  @default(false)
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  payouts          Payout[]
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payout {
  id               String         @id @default(cuid())
  hostId           String
  payoutAccountId  String?
  amount           Int
  currency         String         @default("usd")
  status           String         @default("PENDING")
  provider         String         @default("demo")
  providerPayoutId String?        @unique
  stripeTransferId String?        @unique
  bookingIds       String?
  processedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  scheduledAt      DateTime?
  earnings         HostEarning[]
  payoutAccount    PayoutAccount? @relation(fields: [payoutAccountId], references: [id])
  host             User           @relation(fields: [hostId], references: [id])

  @@index([hostId])
  @@index([status])
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balance      Int                 @default(0)
  currency     String              @default("usd")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id            String   @id @default(cuid())
  walletId      String
  bookingId     String?
  paymentId     String?
  type          String
  amount        Int
  currency      String   @default("usd")
  balanceBefore Int
  balanceAfter  Int
  description   String
  createdAt     DateTime @default(now())
  wallet        Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
}

model Review {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  propertyId    String
  authorId      String
  targetId      String?
  overallRating Int
  cleanliness   Int           @default(5)
  accuracy      Int           @default(5)
  communication Int           @default(5)
  location      Int           @default(5)
  checkIn       Int           @default(5)
  value         Int           @default(5)
  comment       String
  hostResponse  String?
  isPublished   Boolean       @default(true)
  reportCount   Int           @default(0)
  status        String        @default("PUBLISHED")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  target        User?         @relation("ReviewTarget", fields: [targetId], references: [id])
  author        User          @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  property      Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  photos        ReviewPhoto[]
  ratings       ReviewRating?

  @@index([propertyId])
  @@index([authorId])
  @@index([targetId])
  @@index([status])
}

model ReviewPhoto {
  id        String   @id @default(cuid())
  reviewId  String
  imageUrl  String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model ReviewRating {
  id            String   @id @default(cuid())
  reviewId      String   @unique
  cleanliness   Int      @default(5)
  accuracy      Int      @default(5)
  communication Int      @default(5)
  location      Int      @default(5)
  checkIn       Int      @default(5)
  value         Int      @default(5)
  createdAt     DateTime @default(now())
  review        Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]

  @@index([userId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  listingId  String
  createdAt  DateTime @default(now())
  listing    Property @relation(fields: [listingId], references: [id], onDelete: Cascade)
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, listingId])
  @@index([wishlistId])
  @@index([listingId])
}

model Conversation {
  id            String                    @id @default(cuid())
  propertyId    String?
  bookingId     String?                   @unique
  type          String                    @default("direct")
  lastMessageAt DateTime                  @default(now())
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  booking       Booking?                  @relation(fields: [bookingId], references: [id])
  property      Property?                 @relation(fields: [propertyId], references: [id])
  participants  ConversationParticipant[]
  messages      Message[]

  @@index([propertyId])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime     @default(now())
  role           String?
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  messageType    String       @default("text")
  content        String
  imageUrl       String?
  attachmentUrl  String?
  isSystem       Boolean      @default(false)
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  body      String?
  link      String?
  channel   String    @default("in_app")
  status    String    @default("PENDING")
  isRead    Boolean   @default(false)
  readAt    DateTime?
  sentAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([channel])
  @@index([status])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  eventType String
  enabled   Boolean  @default(true)
  frequency String   @default("IMMEDIATE")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType])
  @@index([userId])
}

model SupportTicket {
  id          String           @id @default(cuid())
  userId      String
  subject     String
  description String
  status      String           @default("OPEN")
  priority    String           @default("MEDIUM")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  messages    SupportMessage[]
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([priority])
}

model SupportMessage {
  id            String        @id @default(cuid())
  ticketId      String
  senderId      String
  message       String
  attachmentUrl String?
  createdAt     DateTime      @default(now())
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Dispute {
  id          String            @id @default(cuid())
  bookingId   String            @unique
  userId      String?
  type        String?
  entityId    String?
  reason      String
  description String?
  status      String            @default("OPEN")
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  filer       User?             @relation("DisputeFiler", fields: [userId], references: [id])
  booking     Booking           @relation(fields: [bookingId], references: [id])
  evidence    DisputeEvidence[]

  @@index([status])
  @@index([userId])
}

model DisputeEvidence {
  id        String   @id @default(cuid())
  disputeId String
  fileUrl   String
  fileType  String
  createdAt DateTime @default(now())
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
}

model AdminUser {
  id          String   @id @default(cuid())
  userId      String   @unique
  role        String
  permissions String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role])
  @@index([isActive])
}

model AdminAction {
  id           String   @id @default(cuid())
  adminId      String
  actionType   String
  resourceType String
  resourceId   String?
  oldValue     String?
  newValue     String?
  createdAt    DateTime @default(now())
  admin        User     @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([resourceType, resourceId])
  @@index([actionType])
  @@index([createdAt])
}

model ModerationCase {
  id           String   @id @default(cuid())
  type         String
  status       String   @default("OPEN")
  reason       String
  resourceType String
  resourceId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type, status])
  @@index([resourceType, resourceId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
  userAgent String?
  user      User?    @relation("AuditUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([action])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  eventType  String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([eventType])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model FraudEvent {
  id          String    @id @default(cuid())
  userId      String?
  eventType   String
  status      String    @default("PENDING")
  attempts    Int       @default(1)
  nextRetryAt DateTime?
  metadata    Json?
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

model NotificationQueue {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  nextRetryAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status])
  @@index([type])
  @@index([nextRetryAt])
}

model Job {
  id          String    @id @default(cuid())
  queueName   String
  payload     Json
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  nextRetryAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([queueName, status])
  @@index([status])
  @@index([nextRetryAt])
}

model PaymentProviderConfig {
  id          String       @id @default(cuid())
  name        String       @unique
  type        String
  isActive    Boolean      @default(true)
  config      Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  webhookLogs WebhookLog[]

  @@index([isActive])
}

model WebhookLog {
  id                String                 @id @default(cuid())
  providerId        String?
  providerName      String
  eventType         String
  payload           Json
  signatureVerified Boolean                @default(false)
  processed         Boolean                @default(false)
  error             String?
  createdAt         DateTime               @default(now())
  provider          PaymentProviderConfig? @relation(fields: [providerId], references: [id])

  @@index([providerName])
  @@index([eventType])
  @@index([createdAt])
  @@index([processed])
}

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model CommissionRule {
  id                     String    @id @default(cuid())
  name                   String
  type                   String
  targetId               String?
  guestServiceFeePercent Float
  hostCommissionPercent  Float
  fixedFeeAmount         Int       @default(0)
  isActive               Boolean   @default(true)
  startDate              DateTime?
  endDate                DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([type, targetId])
  @@index([isActive])
}

model Advertisement {
  id             String    @id @default(cuid())
  title          String
  description    String?
  imageUrl       String?
  targetUrl      String
  placement      String
  targetAudience String
  status         String    @default("DRAFT")
  startDate      DateTime?
  endDate        DateTime?
  dailyBudget    Int?
  totalBudget    Int?
  impressions    Int       @default(0)
  clicks         Int       @default(0)
  priority       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([placement])
}
